<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>matin — lecture</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E⚜️%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #14161a;
    --card: #1c1f24;
    --text: #e8e6e1;
    --muted: #8a8d93;
    --accent: #c9a875;
    --border: #2a2d33;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Outfit', sans-serif;
    font-weight: 300;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .card {
    max-width: 480px;
    width: 100%;
  }
  .day-label {
    color: var(--accent);
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .theme {
    color: var(--muted);
    font-size: 15px;
    margin-bottom: 28px;
  }
  .phrase {
    border-bottom: 1px solid var(--border);
    padding: 18px 0;
  }
  .phrase:last-child { border-bottom: none; }
  .fr {
    font-size: 22px;
    font-weight: 400;
    margin-bottom: 4px;
  }
  .pron {
    color: var(--accent);
    font-size: 14px;
    font-style: italic;
    margin-bottom: 4px;
  }
  .en {
    color: var(--muted);
    font-size: 15px;
  }
  .footer {
    margin-top: 32px;
    text-align: center;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 1px;
  }
</style>
</head>
<body>

<div class="card">
  <div class="day-label" id="dayLabel">Day 1</div>
  <div class="theme" id="themeLabel">Morning routine</div>
  <div id="phrases"></div>
  <div class="footer" id="footer">⚜️ back tomorrow for the next one</div>
</div>

<script>
const content = [
  { theme: "Morning routine", items: [
    ["Je me réveille.", "zhuh muh ray-vay", "I wake up."],
    ["Il est sept heures.", "eel ay set uhr", "It's seven o'clock."],
    ["Je prends un café.", "zhuh prahn uhn ka-fay", "I'm having a coffee."],
    ["J'ai bien dormi.", "zhay byan dor-mee", "I slept well."],
    ["Je me brosse les dents.", "zhuh muh bros lay dahn", "I brush my teeth."],
    ["Je suis en retard.", "zhuh swee ahn ruh-tar", "I'm running late."]
  ]},
  { theme: "Getting dressed", items: [
    ["Je m'habille.", "zhuh ma-beey", "I'm getting dressed."],
    ["Il fait froid dehors.", "eel fay frwah duh-or", "It's cold outside."],
    ["Je prends mon sac.", "zhuh prahn mohn sak", "I'm grabbing my bag."],
    ["Où sont mes clés ?", "oo sohn may klay", "Where are my keys?"],
    ["Je mets mes chaussures.", "zhuh may may sho-sure", "I'm putting on my shoes."],
    ["Je suis presque prêt.", "zhuh swee presk pray", "I'm almost ready."]
  ]},
  { theme: "Commute", items: [
    ["Je prends le métro.", "zhuh prahn luh may-tro", "I'm taking the subway."],
    ["C'est bondé aujourd'hui.", "say bohn-day oh-zhoor-dwee", "It's packed today."],
    ["Le train est en retard.", "luh trahn ay ahn ruh-tar", "The train is late."],
    ["Je descends à la prochaine.", "zhuh day-sahn ah la pro-shen", "I get off at the next stop."],
    ["J'ai raté ma correspondance.", "zhay ra-tay ma ko-res-pohn-dahns", "I missed my connection."],
    ["Ça prend vingt minutes.", "sa prahn van mee-newt", "It takes twenty minutes."]
  ]},
  { theme: "At the law firm", items: [
    ["J'ai une réunion à dix heures.", "zhay ewn ray-ewn-yohn ah dee zuhr", "I have a meeting at ten."],
    ["Je dois finir ce document.", "zhuh dwah fee-neer suh do-kew-mahn", "I need to finish this document."],
    ["Pouvez-vous relire ceci ?", "poo-vay voo ruh-leer suh-see", "Can you review this?"],
    ["C'est urgent.", "say ur-zhahn", "It's urgent."],
    ["J'envoie l'e-mail maintenant.", "zhahn-vwah lay-mail man-tuh-nahn", "I'm sending the email now."],
    ["On se voit à la réunion.", "ohn suh vwah ah la ray-ewn-yohn", "See you at the meeting."]
  ]},
  { theme: "At the climbing gym", items: [
    ["Je m'échauffe.", "zhuh may-showf", "I'm warming up."],
    ["C'est une belle voie.", "say ewn bel vwah", "That's a nice route."],
    ["J'ai réussi le bloc !", "zhay ray-oo-see luh blok", "I sent the boulder problem!"],
    ["Assure-moi, s'il te plaît.", "ah-sewr mwah seel tuh play", "Belay me, please."],
    ["Mes doigts sont fatigués.", "may dwah sohn fa-tee-gay", "My fingers are tired."],
    ["On grimpe encore une fois.", "ohn grahmp ahn-kor ewn fwah", "Let's climb one more time."]
  ]},
  { theme: "Evening wind-down", items: [
    ["Je rentre chez moi.", "zhuh rahn-truh shay mwah", "I'm heading home."],
    ["Je vais préparer le dîner.", "zhuh vay pray-pa-ray luh dee-nay", "I'm going to make dinner."],
    ["J'ai eu une longue journée.", "zhay ew ewn lohng zhoor-nay", "I had a long day."],
    ["Je vais me coucher tôt.", "zhuh vay muh koo-shay toh", "I'm going to bed early."],
    ["Demain est un autre jour.", "duh-man ay tuhn oh-truh zhoor", "Tomorrow is another day."],
    ["Bonne nuit.", "bun nwee", "Good night."]
  ]}
];

function todayStr() {
  const d = new Date();
  return d.getFullYear() + "-" + (d.getMonth()+1) + "-" + d.getDate();
}

function daysBetween(a, b) {
  const msPerDay = 1000 * 60 * 60 * 24;
  return Math.round((b - a) / msPerDay);
}

let index = parseInt(localStorage.getItem("matin_index") || "0", 10);
let lastDate = localStorage.getItem("matin_lastDate");
let startDate = localStorage.getItem("matin_startDate");

const today = todayStr();

if (!startDate) {
  startDate = today;
  localStorage.setItem("matin_startDate", startDate);
  localStorage.setItem("matin_lastDate", today);
  localStorage.setItem("matin_index", "0");
  index = 0;
} else if (lastDate !== today) {
  const last = new Date(lastDate);
  const now = new Date(today);
  const elapsed = Math.max(1, daysBetween(last, now));
  index = (index + elapsed) % content.length;
  localStorage.setItem("matin_index", index.toString());
  localStorage.setItem("matin_lastDate", today);
}

const dayNum = daysBetween(new Date(startDate), new Date(today)) + 1;
const set = content[index % content.length];

document.getElementById("dayLabel").textContent = "Day " + dayNum;
document.getElementById("themeLabel").textContent = set.theme;

const container = document.getElementById("phrases");
set.items.forEach(([fr, pron, en]) => {
  const div = document.createElement("div");
  div.className = "phrase";
  div.innerHTML = `<div class="fr">${fr}</div><div class="pron">${pron}</div><div class="en">${en}</div>`;
  container.appendChild(div);
});
</script>

</body>
</html>
